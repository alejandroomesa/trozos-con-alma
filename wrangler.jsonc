{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "libros-eventos",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "trozos-con-alma",
			"database_id": "c566f0d2-4254-4dfe-ab14-6c07f4045513"
		}
	],
	"observability": {
		"enabled": true
	}
}
