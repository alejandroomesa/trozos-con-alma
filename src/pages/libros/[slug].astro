---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { enlaceWhatsApp } from "../../data/contacto";
import { getPublicCollections, getPublicProducts } from "../../lib/public-content";
export const prerender = false;

const { slug } = Astro.params;
const [colecciones, productosPublicados] = await Promise.all([getPublicCollections(), getPublicProducts()]);
const productoEncontrado = productosPublicados.find((item) => item.slug === slug);
const producto = productoEncontrado ?? {
  slug: slug ?? "", coleccion: "", destacado: false, nombre: "", tipo: "", resumen: "", descripcion: "",
  precio: null, portada: "arena", formato: "", paginas: "", opciones: [], textoPortada: "", imageUrl: null, isDemo: false,
};
const coleccion = colecciones.find((item) => item.slug === producto.coleccion) ?? {
  slug: "", nombre: "", resumen: "", etiqueta: "", introduccion: "", ideas: [], cierre: "", imageUrl: null, isDemo: false,
};
if (!productoEncontrado || !coleccion.nombre) Astro.response.status = 404;
const whatsappLink = enlaceWhatsApp(`Hola, he visto el ejemplo «${producto.nombre}» y me gustaría consultar un libro personalizado.`);
const otrosProductos = productosPublicados.filter((item) => item.coleccion === producto.coleccion && item.slug !== producto.slug);
---

<SiteLayout
  title={`${producto.nombre} · ${coleccion.nombre} · Trozos con Alma`}
  description={producto.isDemo
    ? `Vista de demostración de «${producto.nombre}», una idea ficticia para la colección de ${coleccion.nombre.toLowerCase()}.`
    : `${producto.resumen} ${producto.descripcion}`}
>
  <main id="contenido">
    {productoEncontrado && coleccion.nombre ? <>
    {producto.isDemo && <div class="demo-page-banner"><span>VISTA DE DEMOSTRACION</span> Este producto y sus datos son ficticios y provisionales.</div>}
    <section class={`product-detail-hero product-cover-${producto.portada}`}>
      <div class="product-detail-inner">
        <div class="product-detail-art" role="img" aria-label={`Portada del libro ${producto.nombre}`}>
          <span class="product-detail-art-note">{producto.isDemo ? "EJEMPLO DE PORTADA" : "IDEA DE PORTADA"}</span>
          {producto.imageUrl && <img class="product-detail-upload" src={producto.imageUrl} alt={`Portada de ${producto.nombre}`} />}
          {!producto.imageUrl && <>
          <div class="product-cover product-cover-large">
            <span class="product-cover-mark" aria-hidden="true">ta</span>
            <span class="product-cover-flower" aria-hidden="true">✳</span>
            <span class="product-cover-title">{producto.textoPortada.split("\n").map((line) => <span>{line}</span>)}</span>
            <span class="product-cover-caption">TROZOS CON ALMA</span>
          </div>
          </>}
        </div>
        <div class="product-detail-copy">
          <a class="back-link" href={`/colecciones/${coleccion.slug}/`}><span aria-hidden="true">←</span> Colección {coleccion.nombre}</a>
          <p class="eyebrow">{producto.tipo}{producto.isDemo ? " · Ejemplo ficticio" : ""}</p>
          <h1>{producto.nombre}</h1>
          <p class="product-detail-intro">{producto.resumen}</p>
          {producto.descripcion && <p class="product-detail-intro">{producto.descripcion}</p>}
          <div class="demo-price-box"><span>{producto.isDemo ? "Precio de muestra" : "Precio orientativo"}</span><strong>{producto.precio == null ? "Consultar" : `${producto.precio} €`}</strong><small>{producto.isDemo ? "Importe inventado para mostrar el diseño. No es un precio real." : producto.precio == null ? "Consulta el precio de este producto." : "El precio final se confirmará contigo antes del encargo."}</small></div>
          {whatsappLink && <a class="button button-primary" href={whatsappLink} target="_blank" rel="noreferrer">Consultar una idea parecida <span aria-hidden="true">↗</span></a>}
          <p class="no-purchase-note">La web no procesa pedidos ni pagos. La conversación y cualquier presupuesto se gestionan por WhatsApp.</p>
        </div>
      </div>
    </section>

    <section class="section product-specs-section">
      <div class="product-specs-heading">
        <p class="eyebrow">Así se mostraría</p>
        <h2>Un punto de partida<br /><em>para imaginarlo.</em></h2>
        <p>{producto.isDemo ? "Los datos que ves aquí son parte de la demo." : "Información del libro y sus opciones de personalización."}</p>
      </div>
      <div class="product-specs-grid">
        <article class="spec-card"><span class="spec-number">01</span><span class="spec-label">Formato</span><strong>{producto.formato || "A consultar"}</strong><p>Formato indicado para este producto.</p></article>
        <article class="spec-card"><span class="spec-number">02</span><span class="spec-label">Extensión</span><strong>{producto.paginas || "A consultar"}</strong><p>Páginas indicadas para este producto.</p></article>
        <article class="spec-card"><span class="spec-number">03</span><span class="spec-label">Opciones de personalización</span><div class="spec-options">{producto.opciones.map((opcion) => <span>{opcion}</span>)}</div><p>Las opciones disponibles se confirmarán contigo.</p></article>
      </div>
    </section>

    <section class="sample-steps-section">
      <div class="section sample-steps-inner">
        <div>
          <p class="eyebrow eyebrow-light">Sin carrito ni pago</p>
          <h2>Así sería el recorrido<br /><em>de una persona.</em></h2>
          <p>El producto ayuda a imaginar el libro; WhatsApp sirve para conversar sobre lo que realmente necesitas.</p>
        </div>
        <ol>
          <li><span>01</span><div><strong>Descubre</strong><p>Encuentra una idea en su colección.</p></div></li>
          <li><span>02</span><div><strong>Se informa</strong><p>Revisa el ejemplo, sus opciones y el precio orientativo.</p></div></li>
          <li><span>03</span><div><strong>Lo conversa contigo</strong><p>Escribe por WhatsApp para definir el libro y confirmar precio y plazo.</p></div></li>
        </ol>
      </div>
    </section>

    {otrosProductos.length > 0 && <section class="section other-products-section">
      <p class="eyebrow">Más libros de esta colección</p>
      <div class="product-grid">{otrosProductos.map((otro) => <ProductCard product={otro} />)}</div>
    </section>}
    </> : <section class="section"><p class="eyebrow">Página no disponible</p><h1>No encontramos ese libro.</h1><a class="button button-primary" href="/#productos">Volver al catálogo</a></section>}
  </main>
</SiteLayout>
